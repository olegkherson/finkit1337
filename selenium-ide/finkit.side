          "id": "c0120001-0000-4000-8000-000000000016",
          "comment": "Wait for cabinet menu",
          "command": "waitForElementVisible",
          "target": "linkText=Open New Account",
          "targets": [["linkText=Open New Account", "linkText"]],
          "value": "10000"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000017",
          "comment": "Navigate to Open New Account",
          "command": "click",
          "target": "linkText=Open New Account",
          "targets": [["linkText=Open New Account", "linkText"]],
          "value": ""
        },
        {
          "id": "c0120001-0000-4000-8000-000000000018",
          "comment": "Wait for AJAX population of source account options",
          "command": "waitForElementVisible",
          "target": "css=#fromAccountId option",
          "targets": [["css=#fromAccountId option", "css:finder"]],
          "value": "10000"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000019",
          "comment": "Select SAVINGS account type",
          "command": "select",
          "target": "id=type",
          "targets": [["id=type", "id"]],
          "value": "label=SAVINGS"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000020",
          "comment": "Create second account",
          "command": "click",
          "target": "css=input[type='button'][value='Open New Account']",
          "targets": [["css=input[type='button'][value='Open New Account']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c0120001-0000-4000-8000-000000000021",
          "comment": "Wait for newly created account ID",
          "command": "waitForElementVisible",
          "target": "id=newAccountId",
          "targets": [["id=newAccountId", "id"]],
          "value": "10000"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000022",
          "comment": "Store newly opened account number",
          "command": "storeText",
          "target": "id=newAccountId",
          "targets": [["id=newAccountId", "id"]],
          "value": "acc2"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000023",
          "comment": "Navigate to Transfer Funds",
          "command": "click",
          "target": "linkText=Transfer Funds",
          "targets": [["linkText=Transfer Funds", "linkText"]],
          "value": ""
        },
        {
          "id": "c0120001-0000-4000-8000-000000000024",
          "comment": "Wait for both accounts in destination dropdown",
          "command": "waitForElementVisible",
          "target": "css=#toAccountId option:nth-child(2)",
          "targets": [["css=#toAccountId option:nth-child(2)", "css:finder"]],
          "value": "10000"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000025",
          "comment": "Enter transfer amount",
          "command": "type",
          "target": "id=amount",
          "targets": [["id=amount", "id"]],
          "value": "100.00"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000026",
          "comment": "Select second account as destination",
          "command": "select",
          "target": "id=toAccountId",
          "targets": [["id=toAccountId", "id"]],
          "value": "label=${acc2}"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000027",
          "comment": "Submit transfer",
          "command": "click",
          "target": "css=input[type='submit'][value='Transfer']",
          "targets": [["css=input[type='submit'][value='Transfer']", "css:finder"]],
          "value": ""
        },
        {
          "id": "c0120001-0000-4000-8000-000000000028",
          "comment": "Wait for transfer confirmation block",
          "command": "waitForElementVisible",
          "target": "id=showResult",
          "targets": [["id=showResult", "id"]],
          "value": "10000"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000029",
          "comment": "Hard assert transfer completion heading",
          "command": "assertText",
          "target": "css=#showResult h1.title",
          "targets": [["css=#showResult h1.title", "css:finder"]],
          "value": "Transfer Complete!"
        },
        {
          "id": "c0120001-0000-4000-8000-000000000030",
          "comment": "Soft verify transferred amount",
          "command": "verifyText",
          "target": "id=amountResult",
          "targets": [["id=amountResult", "id"]],
          "value": "$100.00"
        }
      ]
    }
  ],
